# HTTP-only initial server check. For browser use set a real DNS name:
# API_ADDRESS=api.your-domain.com
# Caddy obtains and renews HTTPS certificates when DNS points to this EC2 host.
API_ADDRESS=:80

# Exact frontend origin(s), comma-separated, without paths or trailing slashes.
# CORS controls browser access; it is not authentication.
CORS_ORIGINS=http://localhost:5173
